---
import '@fontsource/instrument-serif'
import '@fontsource/instrument-serif/400-italic.css'
import '@fontsource/newsreader'
import '@fontsource/newsreader/400-italic.css'
import '@fontsource/newsreader/600.css'
import '@fontsource/jetbrains-mono'
import '@fontsource/jetbrains-mono/500.css'
import '../styles/global.css'
import DocsTrap from '../components/DocsTrap.astro'
import Shelves from '../components/Shelves.astro'
import Badge from '../components/Badge.astro'
import GrepVsIndex from '../components/GrepVsIndex.astro'
import Gate from '../components/Gate.astro'
import Lifecycle from '../components/Lifecycle.astro'

const title = 'docs-notary'
const description =
  'Tier your docs by trust, put a machine-readable badge on every file, and let a blocking gate keep it true — so your agent never builds from a document that was never a promise.'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — a documentation gate for agent-built repositories</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://magnifito.github.io/docs-notary/" />
    <meta property="og:image" content="https://magnifito.github.io/docs-notary/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://magnifito.github.io/docs-notary/og.png" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='0.9em' font-size='90'>⛩️</text></svg>" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'docs-notary',
        description,
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'macOS, Linux, Windows',
        url: 'https://magnifito.github.io/docs-notary/',
        downloadUrl: 'https://www.npmjs.com/package/@puralex/docs-notary',
        codeRepository: 'https://github.com/magnifito/docs-notary',
        license: 'https://www.apache.org/licenses/LICENSE-2.0',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      })}
    />
  </head>
  <body>
    <!-- stage 1 · the hook. The page is itself a document in the system: each
         section opens with its own frontmatter, and the reader follows a
         document through the promotion lifecycle, reference → shipped. -->
    <header class="doc hero">
      <p class="frontmatter" aria-hidden="true">
        <span class="line"><span class="fence">---</span></span>
        <span class="line"><span class="key">title:</span> <span class="value">Recurring Invoices</span></span>
        <span class="line"><span class="key">kind:</span> <span class="value rust">reference</span></span>
        <span class="line"><span class="key">status:</span> <span class="value rust">reference &nbsp;# not a commitment. never implement from this file.</span></span>
        <span class="line"><span class="fence">---</span></span>
      </p>
      <h1>Your agent found a spec.<br />It was <em>never a promise.</em></h1>
      <p class="lede">
        Docs folders lie to agents. This system makes every file say what it is — and a blocking
        check makes sure it keeps telling the truth.
      </p>
      <div class="cta-row">
        <a class="button primary" href="#install">Install the gate</a>
        <a class="button ghost" href="https://github.com/magnifito/docs-notary">Read the source</a>
      </div>
    </header>

    <!-- stage 2 · the trap -->
    <section class="doc rust-section">
      <p class="frontmatter" aria-hidden="true">
        <span class="line"><span class="fence">---</span></span>
        <span class="line"><span class="key">kind:</span> <span class="value rust">problem</span></span>
        <span class="line"><span class="key">status:</span> <span class="value">active</span></span>
        <span class="line"><span class="fence">---</span></span>
      </p>
      <h2>The trap every docs folder <em>sets by default</em></h2>
      <p>
        A docs tree collects three kinds of files: things you <strong>built</strong>, things you
        <strong>promised</strong>, and things you merely <strong>collected</strong> — competitor
        notes, vendor docs, old ideas. To an agent grepping the tree, all three look identical.
      </p>
      <DocsTrap />
      <p>
        The repo this was built for had 301 files. 208 were competitor notes. Nothing marked them.
        That is not messy — that is a machine for building the wrong thing.
      </p>
    </section>

    <!-- stage 3 · move 1 -->
    <section class="doc">
      <p class="frontmatter" aria-hidden="true">
        <span class="line"><span class="fence">---</span></span>
        <span class="line"><span class="key">kind:</span> <span class="value">mechanism</span></span>
        <span class="line"><span class="key">move:</span> <span class="value">1 of 3</span></span>
        <span class="line"><span class="fence">---</span></span>
      </p>
      <h2>Move 1 — shelve files by <em>trust</em>, not by topic</h2>
      <Shelves />
    </section>

    <!-- stage 4 · move 2 -->
    <section class="doc">
      <p class="frontmatter" aria-hidden="true">
        <span class="line"><span class="fence">---</span></span>
        <span class="line"><span class="key">kind:</span> <span class="value">mechanism</span></span>
        <span class="line"><span class="key">move:</span> <span class="value">2 of 3</span></span>
        <span class="line"><span class="fence">---</span></span>
      </p>
      <h2>Move 2 — every file wears a <em>badge</em></h2>
      <Badge />
    </section>

    <!-- stage 5 · move 3 -->
    <section class="doc">
      <p class="frontmatter" aria-hidden="true">
        <span class="line"><span class="fence">---</span></span>
        <span class="line"><span class="key">kind:</span> <span class="value">mechanism</span></span>
        <span class="line"><span class="key">move:</span> <span class="value">3 of 3</span></span>
        <span class="line"><span class="fence">---</span></span>
      </p>
      <h2>Move 3 — one <em>map</em> instead of a blind grep</h2>
      <GrepVsIndex />
    </section>

    <!-- stage 6 · the gate -->
    <section class="doc">
      <p class="frontmatter" aria-hidden="true">
        <span class="line"><span class="fence">---</span></span>
        <span class="line"><span class="key">kind:</span> <span class="value">gate</span></span>
        <span class="line"><span class="key">status:</span> <span class="value">active</span></span>
        <span class="line"><span class="fence">---</span></span>
      </p>
      <h2>And a gate that <em>keeps it true</em></h2>
      <Gate />
      <p>What it looks like from the terminal:</p>

<pre class="wide"><code><span class="prompt">$</span> npx docs-notary check
<span class="r">docs/reference/crm/pipelines.md:status — is "active" but everything
  under docs/reference/ is status: reference</span>
<span class="r">check-docs FAILED — 1 violation(s).</span>

<span class="prompt">$</span> npx docs-notary check   <span class="c"># after the fix</span>
<span class="g">check-docs: OK</span></code></pre>

      <p class="caption">
        Deliberately not checked: document age, prose style, dates versus git. Those go to a
        non-blocking advisory report — a gate that cries wolf gets bypassed.
      </p>
    </section>

    <!-- stage 7 · the lifecycle -->
    <section class="doc">
      <p class="frontmatter" aria-hidden="true">
        <span class="line"><span class="fence">---</span></span>
        <span class="line"><span class="key">kind:</span> <span class="value">lifecycle</span></span>
        <span class="line"><span class="fence">---</span></span>
      </p>
      <h2>Ideas <em>earn</em> their way to shipped</h2>
      <Lifecycle />
    </section>

    <!-- stage 8 · the skills. Five situations, one skill each; the agent lands
         in a situation, not in a manual. -->
    <section class="doc" id="skills">
      <p class="frontmatter" aria-hidden="true">
        <span class="line"><span class="fence">---</span></span>
        <span class="line"><span class="key">kind:</span> <span class="value">skills</span></span>
        <span class="line"><span class="key">count:</span> <span class="value">5</span></span>
        <span class="line"><span class="fence">---</span></span>
      </p>
      <h2>Five skills, picked by <em>situation</em></h2>
      <p>
        An agent never asks "which command?". It lands in a situation — a red gate, a stray file,
        a plan that claims to be done — and one skill answers it. Each is self-contained, names the
        exact command, and says what no command can do for you.
      </p>
      <ul class="moves">
        <li>
          <span class="move-name">docs-adopt</span>
          <p>
            The tree has no <code>docs/index.json</code>. Survey first, four questions, then the
            migration: tier every file, stamp every badge, wire the gate into CI. Never stamps
            <code>shipped</code> on a plan's own say-so.
          </p>
        </li>
        <li>
          <span class="move-name">docs-sort</span>
          <p>
            Another tool wrote a document where it liked — <code>docs/superpowers/plans/</code>,
            a spec with no frontmatter, a stray the index has never heard of. Read it, pick the
            tier by <em>authority</em>, then one command moves it and writes the badge:
          </p>
<pre><code><span class="prompt">$</span> npx docs-notary mv docs/superpowers/plans/2026-09-04-invoices.md \
    docs/plans/invoices.md --adopt --summary "Recurring invoices, phase 1."
<span class="g">moved … -> docs/plans/invoices.md (kind plan, status draft)</span>
<span class="c">Stamped frontmatter from the heading; check the title, and give it
evidence or code if it claims a state.</span></code></pre>
        </li>
        <li>
          <span class="move-name">docs-promote</span>
          <p>
            A document must change authority: reference to draft, active to shipped, live to
            archive. <code>mv</code> does the move and records where it came from; the gate's
            history-aware rules then refuse a promotion that kept someone else's prose verbatim.
          </p>
        </li>
        <li>
          <span class="move-name">docs-audit</span>
          <p>
            "Are these docs still true?" The gate proves the tree is well-formed; it cannot prove a
            claim. This skill runs <code>advisory</code>, <code>verify</code> and
            <code>impact</code>, then decides document by document: restamp, rewrite, or archive.
          </p>
        </li>
        <li>
          <span class="move-name">docs-gate</span>
          <p>
            <code>check-docs FAILED</code>. Every violation ends in a rule id; the skill maps each
            id to the one fix that removes the cause — and never to a severity change that makes
            CI green.
          </p>
        </li>
      </ul>
      <p class="caption">
        Installed as the docs-notary plugin, two hooks ride along: a "not a commitment" reminder
        whenever a <code>reference</code> document is read, and the gate's verdict after every
        edit under <code>docs/</code>. Neither blocks.
      </p>
    </section>

    <!-- stage 9 · proof -->
    <section class="doc">
      <p class="frontmatter" aria-hidden="true">
        <span class="line"><span class="fence">---</span></span>
        <span class="line"><span class="key">kind:</span> <span class="value">proof</span></span>
        <span class="line"><span class="key">verified_on:</span> <span class="value">2026-08-27</span></span>
        <span class="line"><span class="fence">---</span></span>
      </p>
      <h2>It eats its <em>own cooking</em></h2>
      <p>
        The gate runs on its own repository, in CI, on every push. On its first self-hosted run it
        caught a dead pointer in one of its own comments.
      </p>
      <ul class="stats">
        <li><strong>301</strong> docs migrated, history intact</li>
        <li><strong>248</strong> tests on real git fixtures</li>
        <li><strong>3</strong> operating systems in CI</li>
        <li><strong>1</strong> dependency</li>
        <li><strong>5</strong> skills, tested against the code they describe</li>
      </ul>
    </section>

    <!-- stage 10 · install. The document reaches `shipped`. -->
    <section class="doc" id="install">
      <p class="frontmatter" aria-hidden="true">
        <span class="line"><span class="fence">---</span></span>
        <span class="line"><span class="key">kind:</span> <span class="value">install</span></span>
        <span class="line"><span class="key">status:</span> <span class="value">shipped</span></span>
        <span class="line"><span class="fence">---</span></span>
      </p>
      <h2>Install it, then <em>stop thinking about it</em></h2>

      <div class="paths">
        <div class="path">
          <h3>As a Claude Code plugin — the full treatment</h3>
          <p>
            Your agent surveys the tree, proposes the moves, stamps every badge, and wires the gate
            in. From then on the <a href="#skills">other four skills</a> answer the situations as
            they come up. The skills encode the judgement calls, not just the mechanics.
          </p>
<pre><code><span class="c"># in Claude Code:</span>
<span class="prompt">&gt;</span> /plugin marketplace add magnifito/docs-notary
<span class="prompt">&gt;</span> /plugin install docs-notary@magnifito
<span class="c"># then, in your repository:</span>
<span class="prompt">&gt;</span> set up the documentation system in this repo</code></pre>
        </div>

        <div class="path">
          <h3>From npm — just the tooling</h3>
<pre><code><span class="prompt">$</span> npm install -D @puralex/docs-notary
<span class="prompt">$</span> npx docs-notary init       <span class="c"># fresh tree, gate-clean</span>
<span class="prompt">$</span> npx docs-notary gen        <span class="c"># the map</span>
<span class="prompt">$</span> npx docs-notary check      <span class="c"># the gate</span>
<span class="prompt">$</span> npx docs-notary advisory   <span class="c"># drift report</span></code></pre>
        </div>
      </div>
    </section>

    <!-- footer -->
    <footer class="doc">
      <div class="cta-row">
        <a class="button primary" href="https://github.com/magnifito/docs-notary">Star it on GitHub</a>
        <a class="button ghost" href="https://github.com/magnifito/docs-notary/blob/main/docs/engineering/design.md">The full design, rejected alternatives included</a>
      </div>
      <small>
        Apache-2.0 · plain ESM, Node 20+ ·
        <a href="https://github.com/magnifito/docs-notary/tree/main/skills">skills/</a> is the
        agent-facing procedure
      </small>
    </footer>
  </body>
</html>
