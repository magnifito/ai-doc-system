{
  "name": "@puralex/ai-doc-system",
  "version": "1.3.0",
  "description": "Tier a repository's docs by authority, validate frontmatter, generate an agent-readable index, and enforce it with a blocking gate.",
  "keywords": [
    "documentation",
    "docs-as-code",
    "ai-agents",
    "agent-skills",
    "claude",
    "frontmatter",
    "lint",
    "docs",
    "gate"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magnifito/ai-doc-system.git"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ai-doc-system": "cli/cli.mjs"
  },
  "files": [
    "cli",
    "scripts",
    "hooks",
    "schema",
    "templates",
    "docs",
    "skills"
  ],
  "scripts": {
    "test": "node --test",
    "lint:docs": "node scripts/check-docs.mjs",
    "lint:docs:advisory": "node scripts/check-docs-advisory.mjs",
    "gen:docs-index": "node scripts/gen-docs-index.mjs",
    "fix:docs-frontmatter": "node scripts/fix-docs-frontmatter.mjs"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  }
}
